# Скопируй в .env и заполни. Файл .env в git не коммитится.

# Обязательно: случайная строка, например `openssl rand -hex 32`
TEMA_JWT_SECRET=

TEMA_ENV=local
TEMA_DATABASE_URL=postgresql+asyncpg://tema:tema@localhost:5432/tema
TEMA_REDIS_URL=redis://localhost:6379/0
TEMA_CORS_ORIGINS=["http://localhost:5173"]
TEMA_FRONTEND_URL=http://localhost:5173

# OAuth (необязательно). Callback: http://localhost:8000/api/v1/auth/oauth/<provider>/callback
TEMA_GITHUB_CLIENT_ID=
TEMA_GITHUB_CLIENT_SECRET=
TEMA_YANDEX_CLIENT_ID=
TEMA_YANDEX_CLIENT_SECRET=

# Трейсы в OTLP-коллектор (Jaeger, Grafana Tempo и т.п.)
TEMA_OTEL_ENABLED=false
TEMA_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
